  "faq": [
    {
      "q": "Do I need an appointment?",
      "a": "You can book any of us online. Sundays are by appointment only, and walk-ins are welcome during our weekday and Saturday hours."
    },
    {
      "q": "How much is a haircut?",
      "a": "A standard haircut runs $40–$50, depending on the barber. Check your barber's booking page for current prices."
    },
    {
      "q": "Do you offer senior or military discounts?",
      "a": "Yes. Several of our barbers offer senior (65+) cuts at $30 and military/first responder cuts at $35–$40."
    },
    {
      "q": "Do you do hot towel shaves?",
      "a": "We sure do. Marty does a traditional shave for $40, and a haircut plus traditional shave with hot towel for $75. Viviana and Joe also do traditional razor shaves."
    },
    {
      "q": "Do you take cards?",
      "a": "Yes, we take cards."
    },
    {
      "q": "Is there Wi-Fi and accessible access?",
      "a": "Yes. We have free Wi-Fi, and the shop is wheelchair accessible."
    },
    {
      "q": "What are the hours?",
      "a": "We're open Mon–Fri 9 AM–6 PM and Sat 9 AM–3 PM. Sundays are by appointment only."
    }
  ],
