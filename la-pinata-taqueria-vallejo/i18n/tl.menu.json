{"lang":"tl","dir":"ltr","title":"Menu | La Piñata Taqueria · Vallejo","body":"<a class=\"skip\" href=\"#main\">Lumaktaw sa nilalaman</a>\n<header class=\"topbar\">\n  <div class=\"wrap topbar-in\">\n    <a class=\"brand\" href=\"../\"><span class=\"brand-mark\" aria-hidden=\"true\">LP</span><span>La Piñata Taqueria</span></a>\n    <nav class=\"nav\"><a href=\"../\">Home</a><a href=\"../#visit\">Oras at lokasyon</a></nav>\n    <label class=\"lang-pick\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zM16.3 14a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z\"/></svg><select id=\"langSel\" aria-label=\"Wika\"><option value=\"en\" lang=\"en\">English</option><option value=\"es\" lang=\"es\">Español</option><option value=\"tl\" lang=\"tl\" selected>Tagalog</option><option value=\"vi\" lang=\"vi\">Tiếng Việt</option><option value=\"zh\" lang=\"zh\">中文</option><option value=\"pa\" lang=\"pa\">ਪੰਜਾਬੀ</option><option value=\"hi\" lang=\"hi\">हिन्दी</option><option value=\"ko\" lang=\"ko\">한국어</option><option value=\"ar\" lang=\"ar\">العربية</option></select></label>\n    <a class=\"btn btn-sm btn-primary\" href=\"tel:+17073348381\">Umorder</a>\n  </div>\n</header>\n<main id=\"main\">\n<div class=\"menu-hero\"><div class=\"wrap\">\n  <a class=\"back\" href=\"../\">← La Piñata Taqueria</a>\n  <h1>Menu</h1>\n  <p class=\"menu-intro\">Taco, super burrito, torta, nachos at quesadilla.</p>\n  <div class=\"menu-source\"><p>Maaaring magbago ang mga presyo.</p></div>\n</div><div class=\"stripe\" aria-hidden=\"true\"></div></div>\n<nav class=\"menu-chips\" aria-label=\"Mga seksyon ng menu\"><div class=\"wrap\"><a href=\"#m-tacos\">Tacos</a><a href=\"#m-burritos\">Burritos</a><a href=\"#m-tortas-nachos-quesadillas\">Torta, Nachos at Quesadilla</a><a href=\"#m-drinks\">Inumin</a><a href=\"#m-extras\">Mga extra</a></div></nav>\n<div class=\"wrap menu-body\">\n<section class=\"menu-sec has-img\" id=\"m-tacos\"><div class=\"menu-sec-body\"><h2>Tacos</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Taco</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$3.50</span></div><p class=\"menu-desc\">Karneng gusto mo, may sibuyas, cilantro at salsa.</p></li></ul><div class=\"menu-choices\"><b>Pagpipiliang karne</b><ul><li>Asada (baka)</li><li>Al pastor (maanghang na baboy)</li><li>Suadero (baka)</li><li>Carnitas (hinimay na baboy)</li><li>Pollo (manok)</li><li>Lengua (dila ng baka)</li><li>Cabeza (karne ng ulo ng baka)</li><li>Chorizo</li></ul></div></div><figure class=\"menu-img\"><img src=\"../images/tacos-plate.jpg\" alt=\"Plato ng taco ng La Piñata na may cilantro, sibuyas, labanos at karot\" loading=\"lazy\"></figure></section><section class=\"menu-sec has-img\" id=\"m-burritos\"><div class=\"menu-sec-body\"><h2>Burritos</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Karneng gusto mo, kanin, beans, keso, sour cream, pico de gallo at salsa.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Veggie Burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$14</span></div><p class=\"menu-desc\">Inihaw na sibuyas, inihaw na bell pepper at lettuce.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Shrimp Burrito (hipon)</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$18</span></div><p class=\"menu-desc\">May inihaw na sibuyas at inihaw na bell pepper.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Lengua Burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\"></span></div><p class=\"menu-desc\">Dila ng baka.</p></li></ul></div><figure class=\"menu-img\"><img src=\"../images/burrito-cut.jpg\" alt=\"Super burrito ng La Piñata na hinati sa ibabaw ng foil\" loading=\"lazy\"></figure></section><section class=\"menu-sec has-img\" id=\"m-tortas-nachos-quesadillas\"><div class=\"menu-sec-body\"><h2>Torta, Nachos at Quesadilla</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Torta</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Karneng gusto mo, sour cream, keso, sibuyas, kamatis, jalapeño, abokado at lettuce.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Nachos</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Karneng gusto mo, beans, sour cream, mozzarella cheese, pico de gallo at jalapeño.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Quesadilla</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Karneng gusto mo, keso at pico de gallo, may sour cream at salsa sa gilid.</p></li></ul></div><figure class=\"menu-img\"><img src=\"../images/chips-salsas-pickled-veggies.jpg\" alt=\"Chips, pula at berdeng salsa, atsarang karot at inihaw na jalapeño mula sa La Piñata\" loading=\"lazy\"><figcaption>Chips, salsa at atsarang gulay</figcaption></figure></section><section class=\"menu-sec\" id=\"m-drinks\"><div class=\"menu-sec-body\"><h2>Inumin</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Soda sa lata</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$2</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Mexican soda</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$3</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Tubig</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$1</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Medio Litro</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$4</span></div><p class=\"menu-desc\">Inuming kalahating litro.</p></li></ul></div></section><section class=\"menu-sec\" id=\"m-extras\"><div class=\"menu-sec-body\"><h2>Mga extra</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Keso, sour cream o abokado sa taco</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$0.25</span></div><p class=\"menu-desc\">Bawat isa.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Keso, sour cream o abokado sa burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$1</span></div><p class=\"menu-desc\">Bawat isa.</p></li></ul></div></section>\n\n\n<div class=\"cta-row menu-cta\"><a class=\"btn btn-primary btn-lg\" href=\"tel:+17073348381\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z\"/></svg> Tumawag (707) 334-8381</a><a class=\"btn btn-outline btn-lg\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=La%20Pi%C3%B1ata%20Taqueria%2C%20809%20Broadway%2C%20Vallejo%2C%20CA%2094590\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z\"/></svg> Direksyon</a></div>\n</div>\n</main>\n<footer class=\"footer\">\n  <div class=\"wrap footer-in\">\n    <div><strong>La Piñata Taqueria</strong><br>809 Broadway, Vallejo, CA 94590 · <a href=\"tel:+17073348381\">(707) 334-8381</a></div>\n    <div class=\"credit\">Demo na ginawa para sa La Piñata Taqueria · Demo site na inihanda ni Nathaniel Leger · Hindi ito ang opisyal na website ng La Piñata Taqueria</div>\n  </div>\n</footer>\n<div class=\"mobile-bar\">\n  <a href=\"tel:+17073348381\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z\"/></svg><span>Tumawag</span></a>\n  <a href=\"https://www.google.com/maps/dir/?api=1&amp;destination=La%20Pi%C3%B1ata%20Taqueria%2C%20809%20Broadway%2C%20Vallejo%2C%20CA%2094590\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z\"/></svg><span>Direksyon</span></a>\n  <a href=\"../\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3z\"/></svg><span>Home</span></a>\n</div>","ui":{"openUntil":"Bukas ngayon · hanggang {t}","closedNow":"Sarado ngayon"}}