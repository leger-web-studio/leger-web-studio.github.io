{"lang":"vi","dir":"ltr","title":"Thực đơn | La Piñata Taqueria · Vallejo","body":"<a class=\"skip\" href=\"#main\">Chuyển đến nội dung</a>\n<header class=\"topbar\">\n  <div class=\"wrap topbar-in\">\n    <a class=\"brand\" href=\"../\"><span class=\"brand-mark\" aria-hidden=\"true\">LP</span><span>La Piñata Taqueria</span></a>\n    <nav class=\"nav\"><a href=\"../\">Trang chủ</a><a href=\"../#visit\">Giờ mở cửa &amp; địa chỉ</a></nav>\n    <label class=\"lang-pick\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zM16.3 14a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z\"/></svg><select id=\"langSel\" aria-label=\"Ngôn ngữ\"><option value=\"en\" lang=\"en\">English</option><option value=\"es\" lang=\"es\">Español</option><option value=\"tl\" lang=\"tl\">Tagalog</option><option value=\"vi\" lang=\"vi\" selected>Tiếng Việt</option><option value=\"zh\" lang=\"zh\">中文</option><option value=\"pa\" lang=\"pa\">ਪੰਜਾਬੀ</option><option value=\"hi\" lang=\"hi\">हिन्दी</option><option value=\"ko\" lang=\"ko\">한국어</option><option value=\"ar\" lang=\"ar\">العربية</option></select></label>\n    <a class=\"btn btn-sm btn-primary\" href=\"tel:+17073348381\">Đặt món</a>\n  </div>\n</header>\n<main id=\"main\">\n<div class=\"menu-hero\"><div class=\"wrap\">\n  <a class=\"back\" href=\"../\">← La Piñata Taqueria</a>\n  <h1>Thực đơn</h1>\n  <p class=\"menu-intro\">Taco, super burrito, torta, nachos và quesadilla.</p>\n  <div class=\"menu-source\"><p>Giá có thể thay đổi.</p></div>\n</div><div class=\"stripe\" aria-hidden=\"true\"></div></div>\n<nav class=\"menu-chips\" aria-label=\"Các mục thực đơn\"><div class=\"wrap\"><a href=\"#m-tacos\">Tacos</a><a href=\"#m-burritos\">Burritos</a><a href=\"#m-tortas-nachos-quesadillas\">Torta, nachos &amp; quesadilla</a><a href=\"#m-drinks\">Đồ uống</a><a href=\"#m-extras\">Món thêm</a></div></nav>\n<div class=\"wrap menu-body\">\n<section class=\"menu-sec has-img\" id=\"m-tacos\"><div class=\"menu-sec-body\"><h2>Tacos</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Taco</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$3.50</span></div><p class=\"menu-desc\">Thịt tùy chọn, hành, ngò và salsa.</p></li></ul><div class=\"menu-choices\"><b>Chọn loại thịt</b><ul><li>Asada (bò nướng)</li><li>Al pastor (heo ướp cay)</li><li>Suadero (thịt bò)</li><li>Carnitas (heo xé)</li><li>Pollo (gà)</li><li>Lengua (lưỡi bò)</li><li>Cabeza (thịt đầu bò)</li><li>Chorizo</li></ul></div></div><figure class=\"menu-img\"><img src=\"../images/tacos-plate.jpg\" alt=\"Đĩa taco của La Piñata với ngò, hành, củ cải và cà rốt\" loading=\"lazy\"></figure></section><section class=\"menu-sec has-img\" id=\"m-burritos\"><div class=\"menu-sec-body\"><h2>Burritos</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Thịt tùy chọn, cơm, đậu, phô mai, kem chua, pico de gallo và salsa.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super burrito chay</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$14</span></div><p class=\"menu-desc\">Hành nướng, ớt chuông nướng và xà lách.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super burrito tôm</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$18</span></div><p class=\"menu-desc\">Với hành nướng và ớt chuông nướng.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Burrito lưỡi bò (lengua)</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\"></span></div><p class=\"menu-desc\">Lưỡi bò.</p></li></ul></div><figure class=\"menu-img\"><img src=\"../images/burrito-cut.jpg\" alt=\"Super burrito của La Piñata cắt đôi trên giấy bạc\" loading=\"lazy\"></figure></section><section class=\"menu-sec has-img\" id=\"m-tortas-nachos-quesadillas\"><div class=\"menu-sec-body\"><h2>Torta, nachos &amp; quesadilla</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Torta</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Thịt tùy chọn, kem chua, phô mai, hành, cà chua, ớt jalapeño, bơ và xà lách.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Nachos</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Thịt tùy chọn, đậu, kem chua, phô mai mozzarella, pico de gallo và ớt jalapeño.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Super Quesadilla</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$16</span></div><p class=\"menu-desc\">Thịt tùy chọn, phô mai và pico de gallo, kèm kem chua và salsa riêng.</p></li></ul></div><figure class=\"menu-img\"><img src=\"../images/chips-salsas-pickled-veggies.jpg\" alt=\"Bánh chips, salsa đỏ và xanh, cà rốt ngâm chua và ớt jalapeño nướng của La Piñata\" loading=\"lazy\"><figcaption>Chips, salsa &amp; rau ngâm chua</figcaption></figure></section><section class=\"menu-sec\" id=\"m-drinks\"><div class=\"menu-sec-body\"><h2>Đồ uống</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Nước ngọt lon</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$2</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Nước ngọt Mexico</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$3</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Nước suối</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$1</span></div></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Medio Litro</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$4</span></div><p class=\"menu-desc\">Đồ uống nửa lít.</p></li></ul></div></section><section class=\"menu-sec\" id=\"m-extras\"><div class=\"menu-sec-body\"><h2>Món thêm</h2><ul class=\"menu-items\"><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Thêm phô mai, kem chua hoặc bơ cho taco</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$0.25</span></div><p class=\"menu-desc\">Mỗi loại.</p></li><li class=\"menu-item\"><div class=\"menu-row\"><span class=\"menu-name\">Thêm phô mai, kem chua hoặc bơ cho burrito</span><span class=\"menu-dots\" aria-hidden=\"true\"></span><span class=\"menu-price\">$1</span></div><p class=\"menu-desc\">Mỗi loại.</p></li></ul></div></section>\n\n\n<div class=\"cta-row menu-cta\"><a class=\"btn btn-primary btn-lg\" href=\"tel:+17073348381\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z\"/></svg> Gọi (707) 334-8381</a><a class=\"btn btn-outline btn-lg\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=La%20Pi%C3%B1ata%20Taquer